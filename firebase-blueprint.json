{
  "entities": {
    "MerchantProfile": {
      "title": "MerchantProfile",
      "description": "Profile information for wholesale flower commission agent or mandi trader",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "shopName": { "type": "string", "maxLength": 150 },
        "shopNumber": { "type": "string", "maxLength": 50 },
        "apmcMarketName": { "type": "string", "maxLength": 150 },
        "ownerName": { "type": "string", "maxLength": 100 },
        "phoneNumber": { "type": "string", "maxLength": 20 },
        "defaultCommissionPercent": { "type": "number" },
        "hamaliRatePerBox": { "type": "number" },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["shopName", "phoneNumber", "ownerUid"]
    },
    "Farmer": {
      "title": "Farmer",
      "description": "Farmer consignor registered with mandi merchant",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "village": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["name", "phone", "ownerUid"]
    },
    "SaleLot": {
      "title": "SaleLot",
      "description": "Individual flower lot consignment or transaction parchi record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "parchiNumber": { "type": "string", "maxLength": 50 },
        "farmerId": { "type": "string", "maxLength": 128 },
        "farmerName": { "type": "string", "maxLength": 100 },
        "farmerPhone": { "type": "string", "maxLength": 20 },
        "farmerVillage": { "type": "string", "maxLength": 100 },
        "flowerVariety": { "type": "string", "maxLength": 100 },
        "quantity": { "type": "number" },
        "rate": { "type": "number" },
        "boxesCount": { "type": "number" },
        "grossTotal": { "type": "number" },
        "commissionAmount": { "type": "number" },
        "farmerNetPayable": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["Paid", "Unpaid", "Partial"] },
        "balanceDue": { "type": "number" },
        "date": { "type": "string", "maxLength": 30 },
        "time": { "type": "string", "maxLength": 30 },
        "ownerUid": { "type": "string", "maxLength": 128 }
      },
      "required": ["farmerName", "flowerVariety", "quantity", "rate", "ownerUid"]
    },
    "Shipment": {
      "title": "Shipment",
      "description": "Consolidated multi-variety consignment shipment from farmer",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "shipmentNumber": { "type": "string", "maxLength": 50 },
        "farmerId": { "type": "string", "maxLength": 128 },
        "farmerName": { "type": "string", "maxLength": 100 },
        "farmerPhone": { "type": "string", "maxLength": 20 },
        "farmerVillage": { "type": "string", "maxLength": 100 },
        "totalBoxes": { "type": "number" },
        "grossTotal": { "type": "number" },
        "farmerNetPayable": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["Paid", "Unpaid", "Partial"] },
        "balanceDue": { "type": "number" },
        "date": { "type": "string", "maxLength": 30 },
        "ownerUid": { "type": "string", "maxLength": 128 }
      },
      "required": ["farmerName", "grossTotal", "ownerUid"]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
      "description": "Settlement payout voucher record to a farmer",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "farmerId": { "type": "string", "maxLength": 128 },
        "farmerName": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "paymentMode": { "type": "string", "enum": ["Cash", "UPI", "Bank Transfer", "Cheque"] },
        "date": { "type": "string", "maxLength": 30 },
        "ownerUid": { "type": "string", "maxLength": 128 }
      },
      "required": ["farmerId", "amount", "ownerUid"]
    },
    "Settlement": {
      "title": "Settlement",
      "description": "15-day or periodic finalized settlement statement",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "farmerId": { "type": "string", "maxLength": 128 },
        "farmerName": { "type": "string", "maxLength": 100 },
        "periodStart": { "type": "string", "maxLength": 30 },
        "periodEnd": { "type": "string", "maxLength": 30 },
        "totalSales": { "type": "number" },
        "netPayable": { "type": "number" },
        "status": { "type": "string", "enum": ["settled", "pending"] },
        "ownerUid": { "type": "string", "maxLength": 128 }
      },
      "required": ["farmerId", "periodStart", "periodEnd", "netPayable", "ownerUid"]
    },
    "HelpTicket": {
      "title": "HelpTicket",
      "description": "Support help desk ticket submitted by user or farmer",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ticketNumber": { "type": "string", "maxLength": 50 },
        "subject": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 50 },
        "priority": { "type": "string", "enum": ["Low", "Medium", "High"] },
        "status": { "type": "string", "enum": ["Open", "In Progress", "Resolved"] },
        "description": { "type": "string", "maxLength": 3000 },
        "userName": { "type": "string", "maxLength": 100 },
        "userPhone": { "type": "string", "maxLength": 20 },
        "authorUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["subject", "category", "description", "authorUid"]
    },
    "ConnectionRequest": {
      "title": "ConnectionRequest",
      "description": "Cross-portal connection invite between farmer and merchant",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "senderRole": { "type": "string", "enum": ["farmer", "merchant"] },
        "farmerPhone": { "type": "string", "maxLength": 20 },
        "merchantId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] },
        "authorUid": { "type": "string", "maxLength": 128 }
      },
      "required": ["senderRole", "farmerPhone", "merchantId", "authorUid"]
    },
    "RegisteredAccount": {
      "title": "RegisteredAccount",
      "description": "User account registration profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "phoneNumber": { "type": "string", "maxLength": 20 },
        "role": { "type": "string", "enum": ["merchant", "farmer"] },
        "userUid": { "type": "string", "maxLength": 128 }
      },
      "required": ["name", "phoneNumber", "role", "userUid"]
    }
  },
  "firestore": {
    "/merchants/{merchantId}": {
      "schema": { "$ref": "#/entities/MerchantProfile" },
      "description": "Commission merchant profiles owned by authenticated user"
    },
    "/farmers/{farmerId}": {
      "schema": { "$ref": "#/entities/Farmer" },
      "description": "Farmer directory records maintained by merchant"
    },
    "/lots/{lotId}": {
      "schema": { "$ref": "#/entities/SaleLot" },
      "description": "Mandi sale lot transaction records"
    },
    "/shipments/{shipmentId}": {
      "schema": { "$ref": "#/entities/Shipment" },
      "description": "Multi-item arrival consignments"
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/PaymentRecord" },
      "description": "Payment and voucher history"
    },
    "/settlements/{settlementId}": {
      "schema": { "$ref": "#/entities/Settlement" },
      "description": "Periodic settlement statements"
    },
    "/helpTickets/{ticketId}": {
      "schema": { "$ref": "#/entities/HelpTicket" },
      "description": "Help desk support tickets"
    },
    "/connectionRequests/{requestId}": {
      "schema": { "$ref": "#/entities/ConnectionRequest" },
      "description": "Connection requests between farmers and merchants"
    },
    "/accounts/{accountId}": {
      "schema": { "$ref": "#/entities/RegisteredAccount" },
      "description": "Registered Mandi user accounts"
    }
  }
}
