rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Bharat Mandi Multi-Tenant Security & Isolation Rules

    // Single active device session tracking
    match /user_sessions/{phone} {
      allow read, write: if true;
    }

    // Registered user accounts
    match /accounts/{accountId} {
      allow read, write: if true;
    }

    // Merchant Profiles
    match /merchants/{merchantId} {
      allow read, write: if true;
    }

    // Farmers directory
    match /farmers/{farmerId} {
      allow read, write: if true;
    }

    // Consignment Sale Lots & Invoices (Parchis)
    match /lots/{lotId} {
      allow read, write: if true;
    }
    match /sale_lots/{lotId} {
      allow read, write: if true;
    }

    // Multi-variety shipments
    match /shipments/{shipmentId} {
      allow read, write: if true;
    }

    // Payments & Advances
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // Periodic Settlements
    match /settlements/{settlementId} {
      allow read, write: if true;
    }

    // Direct Statement Syncs
    match /synced_statements/{statementId} {
      allow read, write: if true;
    }

    // Connection Requests between Farmers and Merchants
    match /connectionRequests/{requestId} {
      allow read, write: if true;
    }

    // Support Help Tickets
    match /helpTickets/{ticketId} {
      allow read, write: if true;
    }

    // Fallback collection access
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
